<?xml version="1.0" encoding="utf-8"?>
<!-- Chunky "toy button" look: a darker base layer peeking out from under a lighter top
     layer gives a permanent 3D-popped-out edge, without needing pressed-state swapping. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/coral_primary_dark" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/coral_primary" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
