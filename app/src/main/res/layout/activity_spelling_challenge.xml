<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            style="@style/Text.App.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:gravity="center"
            android:text="✏️ בואו נכתוב את המילה ששמעתם!" />

        <TextView
            android:id="@+id/attemptsText"
            style="@style/Text.App.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/listenButton"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔊 השמע שוב" />

        <LinearLayout
            android:id="@+id/guessesContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/guessInput"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/rubik"
            android:textColor="@color/text_charcoal"
            android:textColorHint="@color/text_charcoal_soft"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:inputType="textCapCharacters"
            android:gravity="center"
            android:textSize="26sp"
            android:hint="הקלד ניחוש" />

        <Button
            android:id="@+id/guessButton"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="נחש" />

        <TextView
            android:id="@+id/resultText"
            style="@style/Text.App.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="19sp"
            android:textColor="@color/coral_primary_dark"
            android:gravity="center"
            android:visibility="gone" />

        <Button
            android:id="@+id/continueButton"
            style="@style/Widget.App.Button.Success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="המשך לבוחן"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
