<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/levelText"
                style="@style/Text.App.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:text="🎮 שלב 1" />

            <TextView
                android:id="@+id/todayCompleteBadge"
                style="@style/Text.App.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_pill_gold"
                android:textColor="@color/gold_reward_dark"
                android:textSize="14sp"
                android:text="✅ השלמת שלב היום"
                android:visibility="gone" />

            <TextView
                android:id="@+id/streakText"
                style="@style/Text.App.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/coral_primary_dark"
                android:layout_marginTop="14dp"
                android:text="🔥 0 שבועות ברצף" />

            <ProgressBar
                android:id="@+id/wordsProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="22dp"
                android:progressDrawable="@drawable/bg_progress_bar"
                android:max="1000" />

            <TextView
                android:id="@+id/wordsProgressText"
                style="@style/Text.App.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="15sp"
                android:text="0 מתוך 1000 מילים" />

            <TextView
                android:id="@+id/nextBadgeText"
                style="@style/Text.App.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textStyle="italic" />

        </LinearLayout>

        <Button
            android:id="@+id/startButton"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="התחל שלב 1" />

        <Button
            android:id="@+id/weeklyQuizButton"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="📝 בוחן שבועי"
            android:visibility="gone" />

        <Button
            android:id="@+id/progressButton"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🗺️ ההתקדמות שלי" />

        <Button
            android:id="@+id/settingsButton"
            style="@style/Widget.App.Button.Neutral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="⚙️ הגדרות" />

    </LinearLayout>
</ScrollView>
