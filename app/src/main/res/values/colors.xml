         Chosen deliberately over a generic blue/purple app look - this is a kids' game, it
         should feel like one. -->

    <!-- Backgrounds -->
    <color name="bg_cream">#FFF7EC</color>
    <color name="bg_card">#FFFFFF</color>

    <!-- Brand -->
    <color name="coral_primary">#FF6B4A</color>
    <color name="coral_primary_dark">#E0502E</color>
    <color name="coral_primary_light">#FFE4DA</color>

    <color name="teal_secondary">#00BFA5</color>
    <color name="teal_secondary_dark">#009481</color>
