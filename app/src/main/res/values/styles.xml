<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.App.Button" parent="android:Widget.Material.Button">
        <item name="android:fontFamily">@font/rubik</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_on_color</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingLeft">28dp</item>
        <item name="android:paddingRight">28dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="Widget.App.Button.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
    </style>

    <style name="Widget.App.Button.Secondary">
        <item name="android:background">@drawable/bg_btn_secondary</item>
    </style>

    <style name="Widget.App.Button.Success">
        <item name="android:background">@drawable/bg_btn_success</item>
    </style>

    <style name="Widget.App.Button.Neutral">
        <item name="android:background">@drawable/bg_btn_neutral</item>
        <item name="android:textColor">@color/text_charcoal</item>
    </style>

    <style name="Text.App.Heading" parent="">
        <item name="android:fontFamily">@font/rubik</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_charcoal</item>
    </style>

    <style name="Text.App.Body" parent="">
        <item name="android:fontFamily">@font/rubik</item>
        <item name="android:textColor">@color/text_charcoal_soft</item>
    </style>

</resources>
